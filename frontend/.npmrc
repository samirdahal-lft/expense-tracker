@robusgauli:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
# The prototype-only dev dep @robusgauli/proto pulls @excalidraw/excalidraw, whose
# React peer ranges conflict under npm's strict peer resolver. The lockfile is already
# consistent; tolerate the peer conflict so `npm ci` (lane runner.web setup, Docker build,
# local dev) installs from it without ERESOLVE.
legacy-peer-deps=true
